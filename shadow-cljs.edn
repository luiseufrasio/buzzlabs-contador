;; shadow-cljs configuration
{:source-paths
 ["src/dev"
  "src/main"
  "src/test"]

 :dependencies
 [[reagent "1.3.0"]
  [re-frame "1.4.3"]
  [binaryage/devtools "1.0.7"]
  [day8.re-frame/re-frame-10x "1.10.0"]]

 :builds
  {
   :app
   {
    :target :browser
    :output-dir "public/js"
    :asset-path "/js"
    :modules {:main {:init-fn buzzlabs-contador.core/init}}
    :devtools {:preloads [day8.re-frame-10x.preload]}
    :dev {:http-root "public"
          :http-port 8080}
    }}}
